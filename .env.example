# ─── 必需配置 ───
# JWT 签名密钥（必填，生产环境务必使用强随机字符串）
JWT_SECRET=your-strong-random-secret-at-least-32-chars

# 字段级加密密钥（64 位 hex，用于加密存储支付密钥/邮箱密码等敏感字段）
# 生产环境务必设置！生成方式: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── 可选配置 ───
# 定时任务触发密钥（设置后通过 ?secret=xxx 触发 /api/cron/check-expired）
CRON_SECRET=

# 数据库由 Cloudflare D1 管理，通过 wrangler.toml/wrangler.jsonc 中的 d1_databases 配置
